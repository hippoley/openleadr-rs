{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenLEADR/openleadr-rs/openleadr-client/tests/external-vtn-evidence.schema.json",
  "title": "OpenLEADR external VTN integration evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "vtn",
    "runner",
    "tests",
    "cleanup"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact git commit used for the run."
    },
    "vtn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "deployment"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "enum": [
            "independent",
            "in-tree",
            "unknown"
          ],
          "description": "independent means the VTN was deployed separately from the test process."
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rust_version",
        "os"
      ],
      "properties": {
        "rust_version": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "ci_run_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "exit_code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "log_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "description": "Digest of a separately retained, redacted log."
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "remaining_resources"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "remaining_resources": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim": {
      "type": "string",
      "enum": [
        "execution-only",
        "effect-observed",
        "independent-vtn-crud",
        "interoperability-candidate"
      ],
      "default": "execution-only",
      "description": "Maximum bounded claim supported by the evidence. effect-observed does not imply this action caused the observed state. This schema never represents certification."
    },
    "effect_verification": {
      "type": "array",
      "description": "Externally readable state observations. Agreement with an expected state does not by itself establish that this test action produced that state.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "resource_type",
          "resource_id",
          "observation",
          "verified",
          "verdict",
          "attribution",
          "pre_action_observation"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "resource_type": {
            "type": "string",
            "minLength": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "enum": [
              "read-after-write",
              "not-found-after-delete",
              "independent-observer"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "before_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "after_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "enum": [
              "matched",
              "mismatched",
              "inconclusive"
            ],
            "description": "Result of comparing the claimed effect with the external observation."
          },
          "attribution": {
            "enum": [
              "unattributed",
              "bounded"
            ],
            "description": "bounded means the run captured evidence that narrows attribution to this action; it is not a universal proof of causality."
          },
          "pre_action_observation": {
            "type": "boolean",
            "description": "Whether target state was observed before the action, so a pre-existing matching state can be detected."
          },
          "operation_correlation": {
            "type": [
              "string",
              "null"
            ],
            "description": "Target-system correlation key linking the action to the observed mutation, when available."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "enum": [
              "independent-vtn-crud",
              "interoperability-candidate"
            ]
          }
        },
        "required": [
          "claim"
        ]
      },
      "then": {
        "required": [
          "effect_verification"
        ],
        "properties": {
          "vtn": {
            "properties": {
              "deployment": {
                "const": "independent"
              }
            }
          },
          "effect_verification": {
            "minItems": 1,
            "not": {
              "contains": {
                "properties": {
                  "verdict": {
                    "enum": [
                      "mismatched",
                      "inconclusive"
                    ]
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "items": {
              "properties": {
                "verified": {
                  "const": true
                },
                "verdict": {
                  "const": "matched"
                },
                "attribution": {
                  "const": "bounded"
                },
                "pre_action_observation": {
                  "const": true
                }
              },
              "required": [
                "verified",
                "verdict",
                "attribution",
                "pre_action_observation"
              ]
            }
          },
          "cleanup": {
            "properties": {
              "verified": {
                "const": true
              },
              "remaining_resources": {
                "const": 0
              }
            },
            "required": [
              "verified",
              "remaining_resources"
            ]
          }
        }
      }
    }
  ]
}
